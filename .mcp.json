{
  "mcpServers": {
    "rea": {
      "command": "env",
      "args": [
        "-u", "CLAUDE_CODE_MESSAGING_TOKEN",
        "-u", "CLAUDE_SESSION_INGRESS_TOKEN_FILE",
        "-u", "AWS_ACCESS_KEY_ID",
        "-u", "AWS_SECRET_ACCESS_KEY",
        "-u", "CLOUDSDK_AUTH_ACCESS_TOKEN",
        "rea-agents", "mcp"
      ],
      "env": {
        "REA_ANALYSIS_PROVIDER": "auto",
        "REA_MCP_TOOL_FAMILIES": "application,electron"
      }
    }
  }
}
